            }
          ]
        },
        "bind": "savings-balance",
        "parse": "currency"
      },
      "expect": [
        {
          "kind": "visible",
          "target": {
            "description": "Member Detail heading",
            "whyRobust": "The stable workflow heading is independent of tenant styling and generated ids.",
            "frame": {
              "strategies": [
                {
                  "kind": "css",
                  "selector": "iframe[title=\"Member servicing workspace\"]"
                }
              ]
            },
            "strategies": [
              {
                "kind": "role",
                "role": "heading",
                "name": "Member Detail",
                "exact": true
              },
              {
                "kind": "text",
                "text": "Member Detail",
                "exact": true
              }
            ]
          }
        }
      ],
      "timeoutMs": 10000,
      "risk": "safe"
    },
    {
