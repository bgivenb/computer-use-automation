    {
      "id": "step-08",
      "description": "Reach the review checkpoint",
      "command": {
        "kind": "click",
        "target": {
          "description": "Continue to review button",
          "whyRobust": "The button role and business action text are stable.",
          "frame": {
            "strategies": [
              {
                "kind": "css",
