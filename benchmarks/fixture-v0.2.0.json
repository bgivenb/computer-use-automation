      "description": "Open the savings sub-account workflow",
      "command": {
        "kind": "click",
        "target": {
          "description": "Open savings sub-account link",
          "whyRobust": "The action's link role and name describe its durable business intent.",
          "frame": {
            "strategies": [
              {
                "kind": "css",
                "selector": "iframe[title=\"Member servicing workspace\"]"
              }
            ]
          },
          "strategies": [
            {
              "kind": "role",
