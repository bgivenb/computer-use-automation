{
  "name": "interface-ai-computer-use",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts serve",
    "discover": "tsx src/cli.ts discover",
    "replay": "tsx src/cli.ts replay",
    "demo": "tsx src/cli.ts demo",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "evidence:verify": "tsx src/evidence/verify.ts",
    "secrets:check": "tsx src/evidence/secret-scan.ts",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run evidence:verify && npm run secrets:check",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
    "openai": "7.7.0",
    "playwright": "1.62.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "22.20.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
